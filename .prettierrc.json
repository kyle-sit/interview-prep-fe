{
    "$schema": "https://json.schemastore.org/prettierrc",
    "semi": true,
    "singleQuote": false,
    "jsxSingleQuote": false,
    "trailingComma": "all",
    "printWidth": 90,
    "tabWidth": 4,
    "useTabs": false,
    "arrowParens": "always",
    "bracketSameLine": false,
    "endOfLine": "lf"
}
